# Copiar a deploy/.env (modo 0600, dueño deploy) en el servidor. Nunca se versiona.
# Las IPs son de ejemplo (RFC 5737); pon las reales de tu instalacion.

# IP LAN del host (nidavellir desde ADR-0010). El puerto 8096 se ata solo aqui, nunca a 0.0.0.0 (RS01).
HOST_LAN_IP=192.0.2.2
# Subred de la LAN: la UNICA que Jellyfin trata como local (network.xml, RS04). La red Docker
# de Bragi nunca debe estar aqui, o todo lo que entra por el tunel pareceria LAN.
LAN_SUBNET=192.0.2.0/24

# URL que Jellyfin anuncia a los clientes. Con el tunel activo, la publica.
# PUBLISHED_URL=https://media.example.com

# Datos persistentes en disco local, fuera del clon (SQLite no tolera NFS).
BRAGI_DATA=/var/lib/bragi
# Raiz de la biblioteca: el contenedor la ve como /media, con /media/TV y /media/movies (ADR-0010).
# En nidavellir es un directorio local que reune dos montajes del host: TV (automount NFS del NAS)
# y movies (bind ro del disco WD). Las rutas de Jellyfin no cambian respecto al NAS.
MEDIA_PATH=/srv/medios/bragi
# Montajes que bragi-arranque espera antes de levantar Jellyfin (separados por espacios).
# Sin definir, solo MEDIA_PATH (el caso de una biblioteca entera en el NAS).
MEDIA_MONTAJES="/srv/medios/bragi/TV /srv/medios/bragi/movies"

# --- Topes (ADR-0002). Medir con deploy/scripts/probar-limites.sh antes de tocarlos ---
BRAGI_CPUS=3.0
BRAGI_MEM=2g

# Usuario del contenedor: el usuario de sistema `bragi` (ADR-0007), nunca el del operador.
# Grupos para /dev/dri. Los rellena bootstrap.sh; a mano: id bragi; getent group render video
PUID=1000
PGID=1000
RENDER_GID=993
VIDEO_GID=44

TZ=UTC

# --- Tunel (ADR-0004). Solo si se activa el perfil ---
# COMPOSE_PROFILES=tunel
# TUNNEL_TOKEN=
# Red interna de Bragi e IP fija del tunel (debe coincidir con KnownProxies de Jellyfin).
# BRAGI_SUBNET=172.30.50.0/24
# TUNEL_IP=172.30.50.10

# Dueño del clon, para el servicio sync.
DEPLOY_UID=996
DEPLOY_GID=987
