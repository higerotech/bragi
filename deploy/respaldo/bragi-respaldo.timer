[Unit]
Description=Bragi: respaldo nocturno de la configuracion

[Timer]
# Hora de la CASA (el host va en UTC). Despues de las tareas pesadas de Jellyfin:
# capitulos 02:00, miniaturas 03:00, escaneo 04:00.
OnCalendar=*-*-* 05:30 America/Caracas
RandomizedDelaySec=10min
# Sin UPS: si un apagon se come la ventana, el respaldo corre al volver.
Persistent=true

[Install]
WantedBy=timers.target
