<?xml version="1.0" encoding="utf-8"?>
<!--
  network.xml de Jellyfin, GESTIONADO DESDE EL REPO (ADR-0006). Lo escribe la tarea `config`
  en cada despliegue: un cambio hecho en el panel de Red de Jellyfin se pierde en el siguiente.

  Las dos lineas que importan (RS04, AB03):
    LocalNetworkSubnets  Solo la LAN. Vacio, Jellyfin deriva la LAN de sus interfaces y la red
                         Docker contaria como local: todo lo que entra por el tunel pareceria LAN.
    KnownProxies         Solo el contenedor del tunel. De cualquier otra IP, X-Forwarded-For se
                         ignora.
-->
<NetworkConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <BaseUrl />
  <EnableHttps>false</EnableHttps>
  <RequireHttps>false</RequireHttps>
  <CertificatePath />
  <CertificatePassword />
  <InternalHttpPort>8096</InternalHttpPort>
  <InternalHttpsPort>8920</InternalHttpsPort>
  <PublicHttpPort>8096</PublicHttpPort>
  <PublicHttpsPort>8920</PublicHttpsPort>
  <AutoDiscovery>false</AutoDiscovery>
  <EnableIPv4>true</EnableIPv4>
  <EnableIPv6>false</EnableIPv6>
  <EnableRemoteAccess>true</EnableRemoteAccess>
  <LocalNetworkSubnets>
    <string>@@LAN_SUBNET@@</string>
  </LocalNetworkSubnets>
  <LocalNetworkAddresses />
  <KnownProxies>
    <string>@@TUNEL_IP@@</string>
  </KnownProxies>
  <IgnoreVirtualInterfaces>true</IgnoreVirtualInterfaces>
  <VirtualInterfaceNames>
    <string>veth</string>
  </VirtualInterfaceNames>
  <EnablePublishedServerUriByRequest>false</EnablePublishedServerUriByRequest>
  <PublishedServerUriBySubnet />
  <RemoteIPFilter />
  <IsRemoteIPFilterBlacklist>false</IsRemoteIPFilterBlacklist>
</NetworkConfiguration>
